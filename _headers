# LuckyForge Lab — 靜態託管標頭（Netlify／Cloudflare Pages）
# CSP 允許站內 inline script（JSON-LD、js class）與 inline style；
# 若日後移除 inline script/style，請收緊為 'self'。

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: index, follow

# 注意：Pages 的 _headers 會「合併」而非「覆寫」同名標頭，
# 因此不要在 /* 再設一次 Cache-Control，否則會與 /assets/* 等規則
# 串接成兩個 max-age。這裡只針對各類型路徑分別指定。

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webmanifest
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/feed.xml
  Cache-Control: public, max-age=3600

/tools/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/*.md
  X-Robots-Tag: noindex, nofollow

/netlify.toml
  X-Robots-Tag: noindex, nofollow

/vercel.json
  X-Robots-Tag: noindex, nofollow
